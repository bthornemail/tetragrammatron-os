{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canvasl.org/schema/canvasl-frontmatter.json",
  "title": "CanvasL Front Matter Schema (Normative)",
  "description": "Schema for CanvasL front matter expressing semantic intent",
  "type": "object",
  "required": ["canvasl", "kernel", "scope", "constraints"],
  "properties": {
    "canvasl": {
      "$ref": "#/$defs/CanvasL"
    },
    "kernel": {
      "$ref": "#/$defs/Kernel"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "constraints": {
      "$ref": "#/$defs/Constraints"
    },
    "folds": {
      "$ref": "#/$defs/Folds"
    },
    "projection": {
      "$ref": "#/$defs/Projection"
    },
    "artifacts": {
      "$ref": "#/$defs/Artifacts"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "CanvasL": {
      "type": "object",
      "required": ["spec", "version", "kind"],
      "properties": {
        "spec": {
          "type": "string",
          "pattern": "^RFC-[0-9]+$",
          "description": "RFC identifier"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Semantic version"
        },
        "kind": {
          "type": "string",
          "enum": ["kernel", "module", "feature", "demo", "test"],
          "description": "CanvasL document kind"
        }
      }
    },
    "Kernel": {
      "type": "object",
      "required": ["name", "axis", "idempotent", "normalization"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Kernel name"
        },
        "axis": {
          "type": "string",
          "enum": ["state", "alphabet", "left_marker", "right_marker", "transition", "start", "accept", "reject"],
          "description": "Semantic axis from 8-tuple"
        },
        "idempotent": {
          "type": "boolean",
          "const": true,
          "description": "Operations must be idempotent"
        },
        "normalization": {
          "type": "string",
          "enum": ["fano"],
          "description": "Normalization method"
        }
      }
    },
    "Scope": {
      "type": "object",
      "required": ["layer", "domain"],
      "properties": {
        "layer": {
          "type": "string",
          "enum": ["main", "current", "feature"],
          "description": "Repository layer"
        },
        "domain": {
          "type": "string",
          "enum": ["state", "alphabet", "left_marker", "right_marker", "transition", "start", "accept", "reject"],
          "description": "Domain axis"
        },
        "inherits": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["kernel", "current"]
          },
          "description": "Allowed inheritance sources"
        }
      }
    },
    "Constraints": {
      "type": "object",
      "required": ["fano", "algebra", "determinism"],
      "properties": {
        "fano": {
          "type": "object",
          "required": ["required", "triads"],
          "properties": {
            "required": {
              "type": "boolean",
              "const": true
            },
            "triads": {
              "type": "string",
              "enum": ["enforced", "optional"],
              "const": "enforced"
            }
          }
        },
        "algebra": {
          "type": "object",
          "required": ["ring", "operations"],
          "properties": {
            "ring": {
              "type": "string",
              "enum": ["F2[x]"],
              "const": "F2[x]"
            },
            "operations": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["meet", "join"]
              },
              "contains": {
                "const": "meet"
              }
            }
          }
        },
        "determinism": {
          "type": "object",
          "required": ["canonical-json", "byte-stable"],
          "properties": {
            "canonical-json": {
              "type": "boolean",
              "const": true
            },
            "byte-stable": {
              "type": "boolean", 
              "const": true
            }
          }
        }
      }
    },
    "Folds": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["CANON", "MEET", "JOIN", "PROJ_FANO"]
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["FLOAT", "APPROX"]
          }
        }
      }
    },
    "Projection": {
      "type": "object",
      "required": ["space", "renderer"],
      "properties": {
        "space": {
          "type": "string",
          "enum": ["fano", "merkaba", "lattice"]
        },
        "dimensionality": {
          "type": "integer",
          "enum": [2, 3, 4]
        },
        "renderer": {
          "type": "object",
          "required": ["type", "canonical"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["svg", "obj", "glb"]
            },
            "canonical": {
              "type": "boolean",
              "const": true
            }
          }
        }
      }
    },
    "Artifacts": {
      "type": "object",
      "properties": {
        "emits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "role"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["json", "jsonl", "canbc", "svg", "obj", "glb"]
              },
              "role": {
                "type": "string",
                "enum": ["canonical", "execution", "bytecode", "visualization"]
              }
            }
          }
        }
      }
    }
  }
}