void can_vm_init(can_vm_t* vm) {
  if (!vm) return;
  memset(vm, 0, sizeof(*vm));
  vm->last_error = VM_ERR_OK;
  vm->halted = false;
}

const char* can_vm_error_string(vm_error_t err) {
  switch (err) {
    case VM_ERR_OK: return "OK";
    case VM_ERR_DECODE: return "Decode error";
    case VM_ERR_BAD_OPCODE: return "Bad opcode";
    case VM_ERR_ASSERT_FAIL: return "Assertion failed";
    case VM_ERR_INVALID_STATE: return "Invalid state";
    case VM_ERR_HALT: return "Halted";
    default: return "Unknown error";
  }
}

// Fano projection omission rule (RFC-009 §X.8.2.1)
static uint8_t fano_omit_register(can_vm_t* vm) {
  uint8_t omit = 0;
  uint32_t min_weight = poly_weight(vm->regs[0].poly_id);
  
  for (uint8_t i = 1; i < 8; i++) {
    uint32_t w = poly_weight(vm->regs[i].poly_id);
    if (w < min_weight || (w == min_weight && i < omit)) {
      min_weight = w;
      omit = i;
    }
  }
  return omit;
}

bool can_vm_step(can_vm_t* vm, const uint8_t* prog_bytes, size_t prog_len) {
  if (!vm || !prog_bytes) {
    if (vm) vm->last_error = VM_ERR_INVALID_STATE;
    return false;
  }

  if (vm->halted) {
    vm->last_error = VM_ERR_HALT;
    return false;
  }

  // Check bounds
  if (vm->pc + 4 > prog_len) {
    vm->last_error = VM_ERR_DECODE;
    return false;
  }

  // Decode instruction
  can_inst_t inst;
  if (!decode_inst_bytes(prog_bytes + vm->pc, &inst)) {
    vm->last_error = VM_ERR_DECODE;
    return false;
  }

  // Execute instruction
  switch (inst.opcode) {
    case OP_NOOP:
      // No operation
      break;

    case OP_HALT:
      vm->halted = true;
      vm->last_error = VM_ERR_HALT;
      break;

    case OP_CANON:
      // Canonicalize state (RFC-009 §X.7.1)
      // For now, canonicalize all registers with poly_id
      for (int i = 0; i < 8; i++) {
        if (vm->regs[i].poly_id != 0) {
          vm->regs[i].poly_id = poly_canonicalize(vm->regs[i].poly_id);
        }
      }
      break;

    case OP_COMMIT:
      // Commit barrier (RFC-009 §X.8.1)
      // Implicitly canonicalize before commit
      for (int i = 0; i < 8; i++) {
        if (vm->regs[i].poly_id != 0) {
          vm->regs[i].poly_id = poly_canonicalize(vm->regs[i].poly_id);
        }
      }
      // TODO: Compute commit hash and emit frame boundary
      break;

    case OP_LDI16H:
      // Load I32 high 16 bits (RFC-009 §X.6.3)
      vm->I32 = (vm->I32 & 0x0000ffff) | ((uint32_t)inst.imm16 << 16);
      break;

    case OP_LDI16L:
      // Load I32 low 16 bits
      vm->I32 = (vm->I32 & 0xffff0000) | (uint32_t)inst.imm16;
      break;

    case OP_USEI32:
      // Use I32 latch (RFC-009 §X.6.3)
      if (inst.A >= 8) {
        vm->last_error = VM_ERR_INVALID_STATE;
        return false;
      }
      switch (inst.B) {
        case 0: vm->regs[inst.A].poly_id = vm->I32; break;
        case 1: vm->regs[inst.A].str_id = vm->I32; break;
        case 2: vm->regs[inst.A].node_id = vm->I32; break;
        case 3: vm->regs[inst.A].mat_id = vm->I32; break;
        default:
          vm->last_error = VM_ERR_INVALID_STATE;
          return false;
      }
      break;

    case OP_MEET_GCD:
      // Meet (GCD) operation (RFC-009 §X.7.2)
      if (inst.A >= 8 || inst.B >= 8) {
        vm->last_error = VM_ERR_INVALID_STATE;
        return false;
      }
      vm->regs[inst.A].poly_id = poly_gcd(
        vm->regs[inst.A].poly_id,
        vm->regs[inst.B].poly_id
      );
      // Result must be canonical
      vm->regs[inst.A].poly_id = poly_canonicalize(vm->regs[inst.A].poly_id);
      break;

    case OP_JOIN_LCM:
      // Join (LCM) operation (RFC-009 §X.7.2)
      if (inst.A >= 8 || inst.B >= 8) {
        vm->last_error = VM_ERR_INVALID_STATE;
        return false;
      }
      vm->regs[inst.A].poly_id = poly_lcm(
        vm->regs[inst.A].poly_id,
        vm->regs[inst.B].poly_id
      );
      // Result must be canonical
      vm->regs[inst.A].poly_id = poly_canonicalize(vm->regs[inst.A].poly_id);
      break;

    case OP_SWAP:
      // Swap registers (RFC-009 Appendix A.4)
      if (inst.A >= 8 || inst.B >= 8) {
        vm->last_error = VM_ERR_INVALID_STATE;
        return false;
      }
      {
        can_reg_t tmp = vm->regs[inst.A];
        vm->regs[inst.A] = vm->regs[inst.B];
        vm->regs[inst.B] = tmp;
      }
      break;

    case OP_CLEAR:
      // Clear register fields (RFC-009 Appendix A.4)
      if (inst.A >= 8) {
        vm->last_error = VM_ERR_INVALID_STATE;
        return false;
      }
      if (inst.imm16 & 0x01) vm->regs[inst.A].poly_id = 0;
      if (inst.imm16 & 0x02) vm->regs[inst.A].str_id = 0;
      if (inst.imm16 & 0x04) vm->regs[inst.A].node_id = 0;
      if (inst.imm16 & 0x08) vm->regs[inst.A].mat_id = 0;
      break;

    case OP_PROJ_FANO:
      // Fano projection (RFC-009 §X.8.2)
      // Omission rule: omit register with minimum weight
      {
        uint8_t omit = fano_omit_register(vm);
        // TODO: Emit Fano projection geometry to frame channel inst.A
        (void)omit; (void)inst;
      }
      break;

    case OP_EMIT_NODE:
      // Emit node (RFC-009 §X.8.3)
      // TODO: Emit node derived from reg[inst.B]
      (void)inst;
      break;

    case OP_EMIT_EDGE:
      // Emit edge (RFC-009 §X.8.3)
      // TODO: Emit edge from/to indices in imm16
      (void)inst;
      break;

    case OP_LIFT_3D:
      // Lift to 3D (RFC-009 §X.8.4)
      // TODO: Lift 2D frame to 3D representation
      (void)inst;
      break;

    case OP_ASSERT_CANON:
      // Assert canonical state (RFC-009 Appendix A.6)
      // TODO: Verify state is canonical
      break;

    case OP_ASSERT_IDEMP:
      // Assert idempotence (RFC-009 Appendix A.6)
      if (inst.A >= 8) {
        vm->last_error = VM_ERR_INVALID_STATE;
        return false;
      }
      // TODO: Verify idempotence property
      (void)inst;
      break;

    case OP_ASSERT_FANO:
      // Assert Fano triad (RFC-009 Appendix A.6)
      {
        uint8_t reg3 = inst.imm16 & 0x0f;
        if (inst.A >= 8 || inst.B >= 8 || reg3 >= 8) {
          vm->last_error = VM_ERR_INVALID_STATE;
          return false;
        }
        // TODO: Verify Fano triad predicate
        (void)reg3;
      }
      break;

    default:
      vm->last_error = VM_ERR_BAD_OPCODE;
      return false;
  }

  // Advance program counter
  vm->pc += 4;
  return true;
}

int can_vm_run(can_vm_t* vm, const uint8_t* prog_bytes, size_t prog_len) {
  if (!vm || !prog_bytes) return -1;

  int steps = 0;
  while (!vm->halted && vm->pc < prog_len) {
    if (!can_vm_step(vm, prog_bytes, prog_len)) {
      if (vm->last_error == VM_ERR_HALT) {
        return steps;
      }
      return -1;
    }
    steps++;
  }

  return steps;
}
