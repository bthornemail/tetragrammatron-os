// can_vm.c
// Origami Fold VM Core Implementation (RFC-009, RFC-0012)
// Role B: COMPILER / VM IMPLEMENTER
// Implements: RFC-009 §X.7, RFC-0012 §5

#include "can_vm.h"
#include <string.h>
#include <stdio.h>

