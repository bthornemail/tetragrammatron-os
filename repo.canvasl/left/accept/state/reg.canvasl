$schema: "canvasl://register/v1"
kind: "repo.register"
fingerprint: "REPO-LATTICE-TIME"
id: "reg.left.accept.state"
axis:
  a: "left"
  b: "accept"
  c: "state"

address:
  a_idx: 2
  b_idx: 6
  c_idx: 0
  addr_u9: 176

semantics:
  summary: ""
  invariants:
    - "Normalization MUST be idempotent"
    - "Serialization MUST be canonical"
  fano_scope:
    participates: true

can_isa_binding:
  bank: 2
  opcode_base: "0x20"
  register: 48

payload:
  poly:
    ring: "F2[x]"
    clbc_poly_v1: null
  events: []
