$schema: "canvasl://register/v1"
kind: "repo.register"
fingerprint: "REPO-LATTICE-TIME"
id: "reg.start.delta.accept"
axis:
  a: "start"
  b: "delta"
  c: "accept"

address:
  a_idx: 5
  b_idx: 4
  c_idx: 6
  addr_u9: 358

semantics:
  summary: ""
  invariants:
    - "Normalization MUST be idempotent"
    - "Serialization MUST be canonical"
  fano_scope:
    participates: true

can_isa_binding:
  bank: 5
  opcode_base: "0x50"
  register: 38

payload:
  poly:
    ring: "F2[x]"
    clbc_poly_v1: null
  events: []
