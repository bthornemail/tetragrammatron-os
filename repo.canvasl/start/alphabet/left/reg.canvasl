$schema: "canvasl://register/v1"
kind: "repo.register"
fingerprint: "REPO-LATTICE-TIME"
id: "reg.start.alphabet.left"
axis:
  a: "start"
  b: "alphabet"
  c: "left"

address:
  a_idx: 5
  b_idx: 1
  c_idx: 2
  addr_u9: 330

semantics:
  summary: ""
  invariants:
    - "Normalization MUST be idempotent"
    - "Serialization MUST be canonical"
  fano_scope:
    participates: true

can_isa_binding:
  bank: 5
  opcode_base: "0x50"
  register: 10

payload:
  poly:
    ring: "F2[x]"
    clbc_poly_v1: null
  events: []
