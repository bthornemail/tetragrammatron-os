$schema: "canvasl://register/v1"
kind: "repo.register"
fingerprint: "REPO-LATTICE-TIME"
id: "reg.start.reject.state"
axis:
  a: "start"
  b: "reject"
  c: "state"

address:
  a_idx: 5
  b_idx: 7
  c_idx: 0
  addr_u9: 376

semantics:
  summary: ""
  invariants:
    - "Normalization MUST be idempotent"
    - "Serialization MUST be canonical"
  fano_scope:
    participates: false

can_isa_binding:
  bank: 5
  opcode_base: "0x50"
  register: 56

payload:
  poly:
    ring: "F2[x]"
    clbc_poly_v1: null
  events: []
