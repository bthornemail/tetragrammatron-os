$schema: "canvasl://register/v1"
kind: "repo.register"
fingerprint: "REPO-LATTICE-TIME"
id: "reg.start.reject.start"
axis:
  a: "start"
  b: "reject"
  c: "start"

address:
  a_idx: 5
  b_idx: 7
  c_idx: 5
