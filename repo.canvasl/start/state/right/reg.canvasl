$schema: "canvasl://register/v1"
kind: "repo.register"
fingerprint: "REPO-LATTICE-TIME"
id: "reg.start.state.right"
axis:
  a: "start"
  b: "state"
  c: "right"

address:
  a_idx: 5
  b_idx: 0
  c_idx: 3
  addr_u9: 323

semantics:
  summary: ""
  invariants:
    - "Normalization MUST be idempotent"
    - "Serialization MUST be canonical"
  fano_scope:
    participates: true

can_isa_binding:
  bank: 5
  opcode_base: "0x50"
  register: 3

payload:
  poly:
    ring: "F2[x]"
    clbc_poly_v1: null
  events: []
