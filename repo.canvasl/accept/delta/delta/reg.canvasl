$schema: "canvasl://register/v1"
kind: "repo.register"
fingerprint: "REPO-LATTICE-TIME"
id: "reg.accept.delta.delta"
axis:
  a: "accept"
  b: "delta"
  c: "delta"

address:
  a_idx: 6
  b_idx: 4
  c_idx: 4
  addr_u9: 420

semantics:
  summary: ""
  invariants:
    - "Normalization MUST be idempotent"
    - "Serialization MUST be canonical"
  fano_scope:
    participates: true

can_isa_binding:
  bank: 6
  opcode_base: "0x60"
  register: 36

payload:
  poly:
    ring: "F2[x]"
    clbc_poly_v1: null
  events: []
