$schema: "canvasl://register/v1"
kind: "repo.register"
fingerprint: "REPO-LATTICE-TIME"
id: "reg.accept.start.left"
axis:
  a: "accept"
  b: "start"
  c: "left"

address:
  a_idx: 6
  b_idx: 5
  c_idx: 2
  addr_u9: 426

semantics:
  summary: ""
  invariants:
    - "Normalization MUST be idempotent"
    - "Serialization MUST be canonical"
  fano_scope:
    participates: true

can_isa_binding:
  bank: 6
  opcode_base: "0x60"
  register: 42

payload:
  poly:
    ring: "F2[x]"
    clbc_poly_v1: null
  events: []
