$schema: "canvasl://register/v1"
kind: "repo.register"
fingerprint: "REPO-LATTICE-TIME"
id: "reg.accept.state.reject"
axis:
  a: "accept"
  b: "state"
  c: "reject"

address:
  a_idx: 6
  b_idx: 0
  c_idx: 7
  addr_u9: 391

semantics:
  summary: ""
  invariants:
    - "Normalization MUST be idempotent"
    - "Serialization MUST be canonical"
  fano_scope:
    participates: false

can_isa_binding:
  bank: 6
  opcode_base: "0x60"
  register: 7

payload:
  poly:
    ring: "F2[x]"
    clbc_poly_v1: null
  events: []
