$schema: "canvasl://register/v1"
kind: "repo.register"
fingerprint: "REPO-LATTICE-TIME"
id: "reg.right.delta.left"
axis:
  a: "right"
  b: "delta"
  c: "left"

address:
  a_idx: 3
  b_idx: 4
  c_idx: 2
  addr_u9: 226

semantics:
  summary: ""
  invariants:
    - "Normalization MUST be idempotent"
    - "Serialization MUST be canonical"
  fano_scope:
    participates: true

can_isa_binding:
  bank: 3
  opcode_base: "0x30"
  register: 34

payload:
  poly:
    ring: "F2[x]"
    clbc_poly_v1: null
  events: []
