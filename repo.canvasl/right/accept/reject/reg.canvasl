$schema: "canvasl://register/v1"
kind: "repo.register"
fingerprint: "REPO-LATTICE-TIME"
id: "reg.right.accept.reject"
axis:
  a: "right"
  b: "accept"
  c: "reject"

address:
  a_idx: 3
  b_idx: 6
  c_idx: 7
  addr_u9: 247

semantics:
  summary: ""
  invariants:
    - "Normalization MUST be idempotent"
    - "Serialization MUST be canonical"
  fano_scope:
    participates: false

can_isa_binding:
  bank: 3
  opcode_base: "0x30"
  register: 55

payload:
  poly:
    ring: "F2[x]"
    clbc_poly_v1: null
  events: []
