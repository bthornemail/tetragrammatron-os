$schema: "canvasl://register/v1"
kind: "repo.register"
fingerprint: "REPO-LATTICE-TIME"
id: "reg.right.state.start"
axis:
  a: "right"
  b: "state"
  c: "start"

address:
  a_idx: 3
  b_idx: 0
  c_idx: 5
  addr_u9: 197

semantics:
  summary: ""
  invariants:
    - "Normalization MUST be idempotent"
    - "Serialization MUST be canonical"
  fano_scope:
    participates: true

can_isa_binding:
  bank: 3
  opcode_base: "0x30"
  register: 5

payload:
  poly:
    ring: "F2[x]"
    clbc_poly_v1: null
  events: []
