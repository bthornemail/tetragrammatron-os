$schema: "canvasl://register/v1"
kind: "repo.register"
fingerprint: "REPO-LATTICE-TIME"
id: "reg.alphabet.delta.delta"
axis:
  a: "alphabet"
  b: "delta"
  c: "delta"

address:
  a_idx: 1
  b_idx: 4
  c_idx: 4
  addr_u9: 100

semantics:
  summary: ""
  invariants:
    - "Normalization MUST be idempotent"
    - "Serialization MUST be canonical"
  fano_scope:
    participates: true

can_isa_binding:
  bank: 1
  opcode_base: "0x10"
  register: 36

payload:
  poly:
    ring: "F2[x]"
    clbc_poly_v1: null
  events: []
