$schema: "canvasl://register/v1"
kind: "repo.register"
fingerprint: "REPO-LATTICE-TIME"
id: "reg.state.alphabet.reject"
axis:
  a: "state"
  b: "alphabet"
  c: "reject"

address:
  a_idx: 0
  b_idx: 1
  c_idx: 7
  addr_u9: 15

semantics:
  summary: ""
  invariants:
    - "Normalization MUST be idempotent"
    - "Serialization MUST be canonical"
  fano_scope:
    participates: false

can_isa_binding:
  bank: 0
  opcode_base: "0x00"
  register: 15

payload:
  poly:
    ring: "F2[x]"
    clbc_poly_v1: null
  events: []
