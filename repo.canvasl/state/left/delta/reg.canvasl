$schema: "canvasl://register/v1"
kind: "repo.register"
fingerprint: "REPO-LATTICE-TIME"
id: "reg.state.left.delta"
axis:
  a: "state"
  b: "left"
  c: "delta"

address:
  a_idx: 0
  b_idx: 2
  c_idx: 4
  addr_u9: 20

semantics:
  summary: ""
  invariants:
    - "Normalization MUST be idempotent"
    - "Serialization MUST be canonical"
  fano_scope:
    participates: true

can_isa_binding:
  bank: 0
  opcode_base: "0x00"
  register: 20

payload:
  poly:
    ring: "F2[x]"
    clbc_poly_v1: null
  events: []
