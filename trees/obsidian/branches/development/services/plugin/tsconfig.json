{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2020",
    "allowJs": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "lib": ["DOM", "ES2020"],
    "types": []
  },
  "include": ["**/*.ts"]
}

