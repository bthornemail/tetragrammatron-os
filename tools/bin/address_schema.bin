// address_schema.bin (packed, versioned)

struct SchemaHeader {
  uint32_t magic;        // 'TADR' = 0x54414452
  uint16_t version;      // 1
  uint8_t  rows;         // 8
  uint8_t  schema_rows;  // 5
};

struct RowSpec {
  uint8_t fixed;         // 1 = fixed, 0 = free
  uint8_t allowed_count; // 0 if free
  uint8_t allowed[16];   // up to 16 values per row (enough here)
};