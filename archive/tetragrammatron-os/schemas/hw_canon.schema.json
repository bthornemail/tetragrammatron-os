{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ulp://schemas/hw_canon.schema.json",
  "title": "ULP Canonical Hardware Record",
  "type": "object",
  "required": ["meta", "fields"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schema_version", "generated_at_utc", "source_set"],
      "properties": {
        "schema_version": {
          "type": "string",
          "description": "Schema version identifier"
        },
        "generated_at_utc": {
          "type": "string",
          "description": "ISO8601 UTC timestamp of generation",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "source_set": {
          "type": "array",
          "description": "List of source files used",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "fields": {
      "type": "object",
      "description": "Canonical fields with quadrant-tagged values",
      "additionalProperties": {
        "type": "object",
        "required": ["q", "v", "evidence"],
        "properties": {
          "q": {
            "type": "string",
            "enum": ["KK", "KU", "UK", "UU"],
            "description": "Quadrant tag"
          },
          "v": {
            "description": "The actual value (any JSON type)"
          },
          "defaulted": {
            "type": "boolean",
            "description": "Whether value was defaulted"
          },
          "evidence": {
            "type": "array",
            "description": "Provenance trail",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}

