# Web Viewer Environment Variables
# Copy this file to .env and modify as needed

# MQTT Broker Configuration
# Default: 192.168.8.1 (OpenWrt router)
VITE_MQTT_BROKER_HOST=192.168.8.1
VITE_MQTT_BROKER_PORT=1883
VITE_MQTT_BROKER_WS_PORT=8080

# Enable/disable MQTT
VITE_MQTT_ENABLED=true

# WebSocket Configuration (for serial bridge)
VITE_WEBSOCKET_URL=ws://localhost:8080

# Enable/disable real-time updates
VITE_ENABLE_REALTIME=true
